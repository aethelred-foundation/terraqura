{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "TERRAQURA_DEPLOYMENT_PROFILE",
    "DATABASE_URL",
    "DATABASE_SSL_MODE",
    "JWT_SECRET",
    "SIWE_DOMAIN",
    "ADMIN_WALLETS",
    "AUDITOR_WALLETS",
    "CHAIN_ID",
    "AETHELRED_RPC_URL",
    "AETHELRED_EXPLORER_URL",
    "ALLOW_INSECURE_TESTNET_RPC",
    "AETHELRED_NETWORK_ANCHOR_BLOCK",
    "AETHELRED_NETWORK_ANCHOR_HASH",
    "ACCESS_CONTROL_ADDRESS",
    "VERIFICATION_ENGINE_ADDRESS",
    "CARBON_CREDIT_ADDRESS",
    "CARBON_MARKETPLACE_ADDRESS",
    "CIRCUIT_BREAKER_ADDRESS",
    "OPERATOR_SIGNER_KEY_FILE",
    "FORWARDER_CONTRACT",
    "RELAYER_SIGNER_KEY_FILE",
    "KYC_PROVIDER",
    "SUMSUB_APP_TOKEN",
    "SUMSUB_SECRET_KEY",
    "SUMSUB_WEBHOOK_SECRET",
    "TERRAQURA_API_ORIGIN",
    "TERRAQURA_ALLOW_INSECURE_UPSTREAM",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_TERRAQURA_DEPLOYMENT_PROFILE",
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
    "NEXT_PUBLIC_AETHELRED_TESTNET_CHAIN_ID",
    "NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL",
    "NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL",
    "NEXT_PUBLIC_ALLOW_INSECURE_TESTNET_RPC",
    "NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_BLOCK",
    "NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_HASH",
    "NEXT_PUBLIC_ACCESS_CONTROL_ADDRESS",
    "NEXT_PUBLIC_VERIFICATION_ENGINE_ADDRESS",
    "NEXT_PUBLIC_CARBON_CREDIT_ADDRESS",
    "NEXT_PUBLIC_CARBON_MARKETPLACE_ADDRESS",
    "NEXT_PUBLIC_CIRCUIT_BREAKER_ADDRESS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "artifacts/**",
        "typechain-types/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["artifacts/**", "typechain-types/**"]
    },
    "deploy": {
      "dependsOn": ["compile"],
      "outputs": []
    }
  }
}
