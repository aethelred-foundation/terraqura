# Combined Docker Compose environment for the public-testnet candidate.
# Copy to .env, replace every REQUIRED value, and keep mode 0600.

# Host loopback bindings. A TLS reverse proxy is the only public listener.
API_PORT=4000
WEB_PORT=3007
LOG_LEVEL=info
TRUST_PROXY=1
API_DOCS_ENABLED=false
API_PUBLIC_ORIGIN=https://api.terraqura.example
WEB_PUBLIC_ORIGIN=https://terraqura.example

# PostgreSQL and API authentication secrets (REQUIRED).
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Browser/SIWE policy. ADMIN_WALLETS requires at least one governance address.
SIWE_DOMAIN=terraqura.example
ADMIN_WALLETS=
AUDITOR_WALLETS=
CORS_ORIGIN=https://terraqura.example

# Five-proxy public-testnet manifest values (REQUIRED; never use legacy
# deployment addresses). Public RPC and explorer URLs must use HTTPS.
CHAIN_ID=7332
AETHELRED_RPC_URL=
AETHELRED_EXPLORER_URL=
ACCESS_CONTROL_ADDRESS=
VERIFICATION_ENGINE_ADDRESS=
CARBON_CREDIT_ADDRESS=
CARBON_MARKETPLACE_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

# API issuance signer file on the host (REQUIRED, mode 0400). Compose mounts it
# read-only as /run/secrets/terraqura_operator_signer.
OPERATOR_SIGNER_KEY_FILE=

# Optional authoritative AETHEL/USD observation. Leave blank to publish USD
# values as unavailable; never substitute another asset's price.
AETHEL_USD_PRICE=

# Production KYC (REQUIRED for this production-mode stack).
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Optional browser connector identifier. The native Aethelred and injected
# wallet paths remain available when this is blank.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional ERC-2771 integration is disabled for this five-proxy candidate.
# Leave both blank. Enabling it requires a separately reviewed contract,
# secret mount, and Compose override.
FORWARDER_CONTRACT=
RELAYER_SIGNER_KEY_FILE=
