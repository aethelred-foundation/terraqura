# Copy to a root-level .env on the backend host. Have the organization's
# custody or secrets-management service materialize signer files outside
# version control with mode 0400 and service-owner access only.

API_PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1
API_DOCS_ENABLED=false
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h

SIWE_DOMAIN=terraqura.aethelred.network
ADMIN_WALLETS=
AUDITOR_WALLETS=
CORS_ORIGIN=https://terraqura.aethelred.network,https://terraqura.vercel.app

CHAIN_ID=7332
AETHELRED_RPC_URL=
AETHELRED_EXPLORER_URL=
ACCESS_CONTROL_ADDRESS=
VERIFICATION_ENGINE_ADDRESS=
CARBON_CREDIT_ADDRESS=
CARBON_MARKETPLACE_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

OPERATOR_SIGNER_KEY_FILE=

KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Optional; leave both blank to disable ERC-2771 relaying.
FORWARDER_CONTRACT=
RELAYER_SIGNER_KEY_FILE=
