# TerraQura API running in production mode against the Aethelred public testnet.

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1
API_DOCS_ENABLED=false

# REQUIRED PostgreSQL connection. Use verify-full for a managed database.
# An in-stack host named "postgres" may use disable on its private network.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full

# REQUIRED application authentication. JWT_SECRET must be at least 32 random
# characters. SIWE_DOMAIN is a hostname, without a path.
JWT_SECRET=
JWT_EXPIRES_IN=24h
SIWE_DOMAIN=terraqura.example
ADMIN_WALLETS=
AUDITOR_WALLETS=
CORS_ORIGIN=https://terraqura.example

# REQUIRED five-proxy manifest values and HTTPS public endpoints.
CHAIN_ID=7332
AETHELRED_RPC_URL=
AETHELRED_EXPLORER_URL=
ACCESS_CONTROL_ADDRESS=
VERIFICATION_ENGINE_ADDRESS=
CARBON_CREDIT_ADDRESS=
CARBON_MARKETPLACE_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

# REQUIRED issuance signer file mounted by the service manager. Inline
# PRIVATE_KEY values are rejected in production.
OPERATOR_SIGNER_KEY_FILE=/run/secrets/terraqura_operator_signer
PRIVATE_KEY=

# Optional authoritative AETHEL/USD value. Blank means USD pricing unavailable.
AETHEL_USD_PRICE=

# REQUIRED production identity provider.
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Disabled optional relayer. Empty values are normalized to "not configured"
# and do not fail startup. This candidate does not deploy a forwarder.
FORWARDER_CONTRACT=
RELAYER_SIGNER_KEY_FILE=
RELAYER_PRIVATE_KEY=
