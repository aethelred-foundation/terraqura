# Direct-IP public-testnet evaluation only. This is not a production profile.
# Copy outside the repository, replace every REQUIRED value, and keep mode 0600.

PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HOST=93.127.132.52
API_PORT=4000
WEB_PORT=3007
LOG_LEVEL=info

# REQUIRED: PostgreSQL and API authentication secrets.
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h

# REQUIRED: exact direct-IP browser identity and governance wallet.
SIWE_DOMAIN=93.127.132.52:3007
ADMIN_WALLETS=
AUDITOR_WALLETS=
CORS_ORIGIN=http://93.127.132.52:3007
WEB_PUBLIC_ORIGIN=http://93.127.132.52:3007

# Fixed public-testnet identity. The exact acknowledgement and anchor are
# required because the currently available RPC transport is plaintext HTTP.
CHAIN_ID=7332
AETHELRED_RPC_URL=http://54.165.44.130:8545
ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc
AETHELRED_NETWORK_ANCHOR_BLOCK=450000
AETHELRED_NETWORK_ANCHOR_HASH=0x1057a62d12eed50d8740fcf51be0cd784db9a4f8f98c9312eee8b8bc7e543ddc

# Optional. Leave blank while no authoritative HTTPS explorer is available.
AETHELRED_EXPLORER_URL=

# REQUIRED: finalized five-proxy manifest values from this deployment.
ACCESS_CONTROL_ADDRESS=
VERIFICATION_ENGINE_ADDRESS=
CARBON_CREDIT_ADDRESS=
CARBON_MARKETPLACE_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

# REQUIRED for API issuance/administrative transactions: absolute host path to
# the container-readable copy owned by numeric UID/GID 1001 with mode 0400. It
# contains exactly one 0x-prefixed 32-byte private key and must derive the
# OPERATOR_SIGNER_ADDRESS used during finalization.
OPERATOR_SIGNER_KEY_FILE=

# REQUIRED by the current wallet connector configuration.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional authoritative AETHEL/USD observation. Blank publishes unavailable.
AETHEL_USD_PRICE=
