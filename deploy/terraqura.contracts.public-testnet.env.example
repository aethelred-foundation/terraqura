# Source this file only from the immutable detached candidate checkout.
# No secret value belongs in this file.

# REQUIRED: reviewed 40-character commit SHA. The preflight refuses any other
# checkout or tracked local modification.
TERRAQURA_SOURCE_COMMIT=

# REQUIRED: public-testnet JSON-RPC and expected chain ID. HTTPS is the default.
# The current evaluation RPC is plaintext, so it additionally requires the
# exact acknowledgement and independently reviewed block anchor below.
AETHELRED_TESTNET_RPC_URL=http://54.165.44.130:8545
AETHELRED_TESTNET_CHAIN_ID=7332
ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc
AETHELRED_NETWORK_ANCHOR_BLOCK=450000
AETHELRED_NETWORK_ANCHOR_HASH=0x1057a62d12eed50d8740fcf51be0cd784db9a4f8f98c9312eee8b8bc7e543ddc

# REQUIRED: absolute path to a mode-0400 or mode-0600 deployment key file.
# The file contains exactly one 0x-prefixed 32-byte private key. PRIVATE_KEY is
# intentionally not part of this ceremony and must be unset in the shell.
DEPLOYER_SIGNER_KEY_FILE=/secure/operator/terraqura-deployer.key

# REQUIRED: durable, access-controlled checkpoint path. Preserve and back up
# this file between bootstrap and finalize; do not place it in Git.
TERRAQURA_DEPLOYMENT_CHECKPOINT=/var/lib/terraqura/aethelred-testnet-7332.checkpoint.json

# REQUIRED: governance/custody owner, fee recipient, and operational signer.
# Each must be a non-zero address. Owner and operator must differ from deployer.
PROTOCOL_OWNER_ADDRESS=
FEE_RECIPIENT_ADDRESS=
OPERATOR_SIGNER_ADDRESS=

# REQUIRED: HTTPS metadata root and reviewed marketplace fee (0-500 bps).
METADATA_BASE_URI=https://metadata.terraqura.example/public-testnet
PLATFORM_FEE_BPS=250

# Safety interlocks. Keep false for preflight. An authorized operator changes
# exactly one flag for the separately approved transaction-bearing phase.
CONFIRM_TESTNET_DEPLOY=false
CONFIRM_TESTNET_FINALIZE=false
