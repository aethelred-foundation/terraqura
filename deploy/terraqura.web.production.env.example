# TerraQura web build/runtime environment for HTTPS production hosting.

# REQUIRED public application, RPC, and explorer origins. HTTPS only.
NEXT_PUBLIC_APP_URL=https://terraqura.example
NEXT_PUBLIC_AETHELRED_TESTNET_CHAIN_ID=7332
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=
NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL=

# REQUIRED five-proxy manifest values. Do not paste old deployment addresses.
NEXT_PUBLIC_ACCESS_CONTROL_ADDRESS=
NEXT_PUBLIC_VERIFICATION_ENGINE_ADDRESS=
NEXT_PUBLIC_CARBON_CREDIT_ADDRESS=
NEXT_PUBLIC_CARBON_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_CIRCUIT_BREAKER_ADDRESS=

# REQUIRED server-side HTTPS API origin. Browser requests use the same-origin
# /api/terraqura gateway. Plain HTTP upstreams are rejected in production.
TERRAQURA_API_ORIGIN=https://api.terraqura.example
TERRAQURA_ALLOW_INSECURE_UPSTREAM=false
NEXT_PUBLIC_API_URL=

# Optional public WalletConnect project identifier.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deliberately absent: multisig, timelock, gasless-marketplace, oracle, and all
# other legacy deployment addresses are outside this five-proxy candidate.
