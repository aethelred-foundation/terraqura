{
  "name": "@aethelred/terraqura",
  "version": "1.0.0",
  "private": true,
  "description": "Auditable carbon-removal lifecycle operations on Aethelred",
  "repository": {
    "type": "git",
    "url": "https://github.com/aethelred-io/terraqura.git"
  },
  "license": "Apache-2.0",
  "author": "Aethelred <dev@aethelred.io>",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:api": "pnpm --filter @terraqura/types build && pnpm --filter @terraqura/api build",
    "build:web": "pnpm --filter @terraqura/types build && pnpm --filter @aethelred/terraqura-web build",
    "start:api": "pnpm --filter @terraqura/api start",
    "start:web": "pnpm --filter @aethelred/terraqura-web start",
    "db:migrate": "pnpm --filter @terraqura/api db:migrate",
    "contracts:compile": "pnpm --filter @terraqura/contracts compile",
    "contracts:test": "pnpm --filter @terraqura/contracts test",
    "contracts:rpc:check": "pnpm --filter @terraqura/contracts deploy:testnet:rpc:check",
    "contracts:signer-key:check": "pnpm --filter @terraqura/contracts deploy:testnet:signer-key:check",
    "contracts:preflight": "pnpm --filter @terraqura/contracts deploy:testnet:preflight",
    "contracts:bootstrap": "pnpm --filter @terraqura/contracts deploy:testnet:bootstrap",
    "contracts:finalize": "pnpm --filter @terraqura/contracts deploy:testnet:finalize",
    "contracts:verify": "pnpm --filter @terraqura/contracts deploy:testnet:verify",
    "compose:config": "docker compose --env-file .env -f docker-compose.production.yml config --quiet",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:all": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "20.18.x",
    "pnpm": "9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@fastify/static": "10.1.2",
      "@hono/node-server": ">=1.14.1",
      "@metamask/sdk": "0.33.1",
      "@metamask/sdk-communication-layer": "0.33.1",
      "@openzeppelin/contracts": "4.9.6",
      "@openzeppelin/contracts-upgradeable": "4.9.6",
      "adm-zip": "^0.6.0",
      "ajv@8.17.1": "8.18.0",
      "axios": "1.18.1",
      "bn.js@4.12.2": "4.12.3",
      "bn.js@>=5.0.0 <5.2.3": "5.2.3",
      "brace-expansion": "5.0.9",
      "cross-spawn": "7.0.6",
      "defu": "6.1.7",
      "fast-jwt": "6.2.4",
      "fast-uri": "3.1.5",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "find-my-way": "9.7.0",
      "flatted": ">=3.3.4",
      "follow-redirects": "^1.16.0",
      "form-data": "4.0.6",
      "glob": "10.5.0",
      "h3": "1.15.9",
      "handlebars": "4.7.9",
      "hono": "4.12.27",
      "immutable": "^5.1.8",
      "js-cookie": "^3.0.7",
      "js-yaml@>=3.0.0 <4.0.0": "3.15.1",
      "js-yaml@>=4.0.0 <5.0.0": "4.3.1",
      "lodash": "4.18.1",
      "minimatch": "10.2.3",
      "parse-duration": "2.1.6",
      "path-to-regexp": "0.1.13",
      "picomatch": "4.0.4",
      "postcss": "8.5.23",
      "protobufjs@>=7.0.0 <7.5.5": "7.6.5",
      "qs": "^6.15.2",
      "semver": "7.5.2",
      "serialize-javascript": "7.0.5",
      "sharp": "0.35.0",
      "shell-quote": "1.9.0",
      "socket.io-parser": "4.2.7",
      "svgo": "4.0.2",
      "tar": "7.5.19",
      "tmp": "^0.2.6",
      "turbo": "^2.9.14",
      "undici": "^6.28.0",
      "uuid": "11.1.1",
      "vite": "6.4.3",
      "vitest": "^3.2.6",
      "websocket-driver": "0.7.5",
      "ws@>=7.0.0 <8.0.0": "7.5.11",
      "ws@>=8.0.0 <9.0.0": "8.21.0",
      "yaml": "2.8.3"
    }
  }
}
