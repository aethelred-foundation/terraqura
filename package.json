{
  "name": "@aethelred/terraqura",
  "version": "1.0.0",
  "private": true,
  "description": "Institutional-Grade Carbon Asset Platform with Proof-of-Physics Verification - Aethelred dApp #5",
  "repository": {
    "type": "git",
    "url": "https://github.com/aethelred-io/terraqura.git"
  },
  "license": "Apache-2.0",
  "author": "Aethelred <dev@aethelred.io>",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "scripts": {
    "build": "turbo build --filter=!@terraqura/subgraph",
    "build:subgraph": "pnpm --filter @terraqura/subgraph build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:python": "cd apps/analytics && python -m pytest tests/ -v",
    "test:rust": "cd apps/verifier && cargo test",
    "test:go": "cd apps/indexer && go test ./...",
    "test:api-golden": "cd apps/api && ./node_modules/.bin/vitest run test/integration/full-flow.test.ts",
    "test:database-domain": "cd packages/database && node --import tsx/esm tests/domain-audit-export.test.ts",
    "test:security-sim": "cd apps/contracts && ./node_modules/.bin/hardhat test test/SabotagePathTests.test.ts test/MultisigFaultInjection.test.ts test/GaslessMetaTransaction.test.ts test/CircuitBreaker.test.ts",
    "test:production-launch-gate": "node --test scripts/production-launch-gate.test.mjs",
    "test:all": "turbo test && pnpm test:python && pnpm test:rust && pnpm test:go",
    "evidence:production-template": "node scripts/create-production-evidence-pack.mjs",
    "validate:network": "cd packages/network-manifest && ./node_modules/.bin/tsup && node dist/validate.js",
    "validate:production-artifacts": "node scripts/production-launch-gate.mjs --artifacts-only",
    "validate:production-launch": "node scripts/production-launch-gate.mjs",
    "validate:enterprise": "corepack pnpm@9.0.0 validate:network && cd packages/subgraph && node ./scripts/validate-manifest.cjs && cd ../.. && corepack pnpm@9.0.0 test:api-golden && corepack pnpm@9.0.0 test:database-domain && corepack pnpm@9.0.0 test:security-sim && corepack pnpm@9.0.0 test:production-launch-gate && corepack pnpm@9.0.0 validate:production-artifacts && node scripts/enterprise-readiness-check.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "build:web": "turbo build --filter=@aethelred/terraqura-web",
    "start:web": "pnpm --filter @aethelred/terraqura-web start",
    "build:api": "turbo build --filter=@terraqura/api",
    "start:api": "pnpm --filter @terraqura/api start"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "next": "^16.2.3",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@graphprotocol/graph-cli@0.67.4": "patches/@graphprotocol__graph-cli@0.67.4.patch"
    },
    "overrides": {
      "fast-xml-parser": ">=5.3.5",
      "tar": ">=7.5.8",
      "underscore": ">=1.13.7",
      "minimatch": ">=9.0.6",
      "cross-spawn": ">=7.0.5",
      "semver": ">=7.5.2",
      "serialize-javascript": ">=7.0.4",
      "undici": "~6.21.0",
      "flatted": ">=3.4.2",
      "flat-cache": ">=6.1.0",
      "svgo": ">=3.3.3",
      "@hono/node-server": ">=1.14.1",
      "hono": ">=4.12.4",
      "axios": ">=1.15.2",
      "fast-jwt": ">=6.2.4",
      "protobufjs": ">=7.5.5",
      "picomatch": ">=4.0.4",
      "defu": ">=6.1.7",
      "drizzle-orm": ">=0.45.2",
      "path-to-regexp": ">=8.2.0",
      "react-router@5>path-to-regexp": "1.9.0",
      "immutable": ">=5.0.0",
      "@openzeppelin/contracts-upgradeable": ">=4.8.3",
      "parse-duration": ">=2.1.3",
      "fastify": ">=5.7.2",
      "rollup": ">=4.59.0",
      "h3": ">=1.15.11",
      "socket.io-parser": ">=4.2.6",
      "socket.io-client": ">=4.8.3",
      "glob": ">=10.5.0",
      "postcss": ">=8.4.32",
      "body-parser": ">=1.20.3",
      "send": ">=0.19.0",
      "serve-static": ">=1.16.0",
      "express": ">=4.21.1",
      "braces": ">=3.0.3",
      "micromatch": ">=4.0.8",
      "nanoid": ">=3.3.7",
      "follow-redirects": ">=1.15.9",
      "webpack": ">=5.94.0",
      "word-wrap": ">=1.2.4",
      "loader-utils": ">=2.0.4",
      "decode-uri-component": ">=0.2.2",
      "minimist": ">=1.2.8"
    }
  }
}
