# TerraQura API — required runtime environment.
#
# Every variable below is REQUIRED: the API refuses to start without it, and
# `pnpm db:migrate` fails the same way because it loads the same config.
# Everything not listed here has a default or is optional.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://terraqura:CHANGE_ME@localhost:5432/terraqura
# require | prefer | disable — defaults to "require"; use disable for a local
# Postgres without TLS.
DATABASE_SSL_MODE=disable

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_characters_long_secret_value
# The domain users sign in against (SIWE). Host only, no scheme.
SIWE_DOMAIN=localhost:3000

# ─── Chain ───────────────────────────────────────────────────────────────────
CHAIN_ID=7332
AETHELRED_RPC_URL=http://54.165.44.130:8545
# Needed only for a plaintext (non-TLS) RPC, as on the evaluation testnet.
ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc

# ─── Deployed contract addresses ─────────────────────────────────────────────
# Take these from the bootstrap output / checkpoint file after a successful
# contracts:bootstrap. All five are required.
ACCESS_CONTROL_ADDRESS=0x0000000000000000000000000000000000000000
VERIFICATION_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
CARBON_CREDIT_ADDRESS=0x0000000000000000000000000000000000000000
CARBON_MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
CIRCUIT_BREAKER_ADDRESS=0x0000000000000000000000000000000000000000
