# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The API refuses to start without every one of these, and
# `pnpm db:migrate` fails identically because it loads the same config.
# Everything else in this file has a default or is optional.
#
#   DATABASE_URL                 JWT_SECRET (>= 32 chars)      SIWE_DOMAIN
#   CHAIN_ID                     AETHELRED_RPC_URL
#   ACCESS_CONTROL_ADDRESS       VERIFICATION_ENGINE_ADDRESS
#   CARBON_CREDIT_ADDRESS        CARBON_MARKETPLACE_ADDRESS
#   CIRCUIT_BREAKER_ADDRESS
#
# The five contract addresses come from the contracts:bootstrap output, which
# is why this only bites after a successful deploy. A plaintext RPC also needs
# ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1
API_DOCS_ENABLED=false

# Browser and wallet authentication origins.
CORS_ORIGIN=https://terraqura.aethelred.network,https://terraqura.vercel.app
SIWE_DOMAIN=terraqura.aethelred.network
ADMIN_WALLETS=
AUDITOR_WALLETS=

# Durable PostgreSQL storage. Use verify-full for managed databases. A private
# in-stack database may use disable because traffic remains on the Docker
# internal network.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Published Aethelred public testnet deployment. Do not reuse addresses from a
# different chain. Public production endpoints must use HTTPS.
CHAIN_ID=7332
AETHELRED_RPC_URL=
AETHELRED_EXPLORER_URL=
ACCESS_CONTROL_ADDRESS=
VERIFICATION_ENGINE_ADDRESS=
CARBON_CREDIT_ADDRESS=
CARBON_MARKETPLACE_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=

# Optional authoritative AETHEL/USD value. Leave blank to return null for USD
# analytics; never substitute another asset's price.
AETHEL_USD_PRICE=

# Administrative whitelist and issuance signer. Production reads this secret
# from a mounted file; PRIVATE_KEY is accepted only during local development.
OPERATOR_SIGNER_KEY_FILE=/run/secrets/terraqura_operator_signer
PRIVATE_KEY=

# KYC provider. Production must use a configured provider.
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Provisioned sensor ingestion keys, comma-separated.

# Optional ERC-2771 relayer. Leave FORWARDER_CONTRACT empty to disable it.
FORWARDER_CONTRACT=
RELAYER_SIGNER_KEY_FILE=/run/secrets/terraqura_relayer_signer
RELAYER_PRIVATE_KEY=
