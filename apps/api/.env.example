# Runtime
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Public web origin used by CORS and SIWE domain validation.
CORS_ORIGIN=https://terraqura.aethelred.network
SIWE_DOMAIN=terraqura.aethelred.network

# Persistent registry state and API sessions.
DATABASE_URL=postgresql://terraqura:replace-me@127.0.0.1:5432/terraqura
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Aethelred public testnet.
CHAIN_ID=78432
AETHELRED_RPC_URL=https://rpc-testnet.aethelred.network
ACCESS_CONTROL_ADDRESS=0x55695aAAEC30AB495074c57e85Ae2E1A4866B83b
VERIFICATION_ENGINE_ADDRESS=0x8dad7E87646e9607Fae225e3A7EAD17ce179dEA8
CARBON_CREDIT_ADDRESS=0x29B58064fD95b175e5824767d3B18bACFafaF959
CARBON_MARKETPLACE_ADDRESS=0x5a4cb32709AB829E2918F0a914FBa1e0Dab2Fdec
CIRCUIT_BREAKER_ADDRESS=0x24192ecf06aA782F1dF69878413D217d9319e257

# Server signer used only for administrative whitelist and issuance operations.
# Never commit the real key.
PRIVATE_KEY=

# KYC provider. Production must use sumsub or onfido with real credentials.
KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
ONFIDO_API_TOKEN=

# Provisioned sensor ingestion keys, comma-separated.
SENSOR_API_KEYS=

# Optional gasless relayer.
FORWARDER_CONTRACT=
RELAYER_PRIVATE_KEY=
DEFENDER_RELAYER_API_KEY=
DEFENDER_RELAYER_API_SECRET=
