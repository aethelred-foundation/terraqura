# ─── Network ───
NEXT_PUBLIC_TERRAQURA_NETWORK=aethelredTestnet
NEXT_PUBLIC_TERRAQURA_DEPLOYMENT=aethelredTestnetPending
NEXT_PUBLIC_USE_TESTNET=true
NEXT_PUBLIC_AETHELRED_CHAIN_ID=7331
NEXT_PUBLIC_AETHELRED_TESTNET_CHAIN_ID=7332
NEXT_PUBLIC_AETHELRED_RPC_URL=https://evm-rpc.aethelred.network
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=https://evm-rpc-testnet.aethelred.network
NEXT_PUBLIC_AETHELRED_EXPLORER_URL=https://explorer.aethelred.network
NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL=https://explorer-testnet.aethelred.network

# Optional deployed Aethelred contract overrides.
# NEXT_PUBLIC_TERRAQURA_CONTRACT_ACCESS_CONTROL=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_VERIFICATION_ENGINE=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_CARBON_CREDIT=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_CARBON_MARKETPLACE=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_GASLESS_MARKETPLACE=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_MULTISIG=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_TIMELOCK=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_CIRCUIT_BREAKER=0x...
# NEXT_PUBLIC_TERRAQURA_CONTRACT_NATIVE_IOT_ORACLE=0x...

# ─── API ───
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/terraqura/carbon-credits

# ─── Wallet ───
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── App ───
NEXT_PUBLIC_APP_URL=https://terraqura.aethelred.network
NEXT_PUBLIC_ERROR_REPORTING_URL=
NEXT_PUBLIC_TERRAQURA_DASHBOARD_DATA_MODE=preview

# ─── Analytics (self-hosted, cookieless — Umami) ───
# Leave blank to disable analytics entirely (dev/CI/preview default).
# Point these at your self-hosted Umami instance; the tracker loads only after
# the visitor accepts analytics in the cookie banner.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
