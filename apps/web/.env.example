# Copy to apps/web/.env.local — Next.js reads env files from the app
# directory it builds in, NOT from the monorepo root.

# Published Aethelred public testnet. Wallet mutations remain disabled when the
# HTTPS RPC or any core TerraQura contract address is missing.
NEXT_PUBLIC_AETHELRED_TESTNET_CHAIN_ID=7332
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=
NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL=

# These four are read by src/lib/wagmi.ts and were previously undocumented.
# They are REQUIRED TOGETHER whenever the RPC above is plaintext http://
# rather than https:// — the policy rejects the endpoint unless all of them
# are present, so setting one or two of them changes nothing.
#
# For the published Aethelred public testnet over plaintext HTTP:
#   NEXT_PUBLIC_TERRAQURA_DEPLOYMENT_PROFILE=public-testnet-evaluation
#   NEXT_PUBLIC_ALLOW_INSECURE_TESTNET_RPC=acknowledge-evaluation-only-plaintext-rpc
#   NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_BLOCK=<operator-confirmed block>
#   NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_HASH=<that block's hash>
#
# Leave all four unset when the RPC is https://.
NEXT_PUBLIC_TERRAQURA_DEPLOYMENT_PROFILE=
NEXT_PUBLIC_ALLOW_INSECURE_TESTNET_RPC=
NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_BLOCK=
NEXT_PUBLIC_AETHELRED_NETWORK_ANCHOR_HASH=

NEXT_PUBLIC_ACCESS_CONTROL_ADDRESS=
NEXT_PUBLIC_VERIFICATION_ENGINE_ADDRESS=
NEXT_PUBLIC_CARBON_CREDIT_ADDRESS=
NEXT_PUBLIC_CARBON_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_CIRCUIT_BREAKER_ADDRESS=

# Multisig, timelock, gasless-marketplace, oracle, and other legacy deployment
# addresses are intentionally absent from the five-proxy candidate.

# The production browser uses the same-origin /api/terraqura gateway.
TERRAQURA_API_ORIGIN=
TERRAQURA_ALLOW_INSECURE_UPSTREAM=false
NEXT_PUBLIC_API_URL=

# Public browser connector identifier.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_APP_URL=https://terraqura.aethelred.network
