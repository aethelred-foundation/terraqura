# ─── Aethelred testnet ───
# Keep this chain ID and RPC aligned with the node selected by the testnet team.
NEXT_PUBLIC_USE_TESTNET=true
NEXT_PUBLIC_AETHELRED_TESTNET_CHAIN_ID=78432
NEXT_PUBLIC_AETHELRED_TESTNET_RPC_URL=https://rpc-testnet.aethelred.network
NEXT_PUBLIC_AETHELRED_TESTNET_EXPLORER_URL=https://explorer-testnet.aethelred.network

# Contracts deployed on the selected Aethelred testnet.
NEXT_PUBLIC_ACCESS_CONTROL_ADDRESS=0x55695aAAEC30AB495074c57e85Ae2E1A4866B83b
NEXT_PUBLIC_VERIFICATION_ENGINE_ADDRESS=0x8dad7E87646e9607Fae225e3A7EAD17ce179dEA8
NEXT_PUBLIC_CARBON_CREDIT_ADDRESS=0x29B58064fD95b175e5824767d3B18bACFafaF959
NEXT_PUBLIC_CARBON_MARKETPLACE_ADDRESS=0x5a4cb32709AB829E2918F0a914FBa1e0Dab2Fdec
NEXT_PUBLIC_CIRCUIT_BREAKER_ADDRESS=0x24192ecf06aA782F1dF69878413D217d9319e257

# ─── API ───
# Browser requests use the same-origin /api/terraqura gateway in production.
# Configure TERRAQURA_API_ORIGIN only in the server/deployment environment so
# the backend topology is not exposed to browsers.
TERRAQURA_API_ORIGIN=http://localhost:4000
# Production upstreams must use HTTPS. This escape hatch is only for a
# temporary private/VPS migration and must never be enabled for public traffic.
TERRAQURA_ALLOW_INSECURE_UPSTREAM=false
# Optional browser override for local development only.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/terraqura/carbon-credits

# ─── Wallet ───
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=7a4f9c2e1b8d43c6a095f2e7d4b1c830

# ─── App ───
NEXT_PUBLIC_APP_URL=https://terraqura.aethelred.network
